{
  "name": "pixel-notes",
  "displayName": "PixelNotes",
  "description": "A pixel-art retro office note-taking sidebar for VS Code — write notes, attach code references, and send to AI.",
  "version": "1.0.0",
  "publisher": "Sakethg",
  "repository": {
    "type": "git",
    "url": "https://github.com/Saketh-Gurram/VS_code_note_taker.git"
  },
  "homepage": "https://github.com/Saketh-Gurram/VS_code_note_taker",
  "bugs": {
    "url": "https://github.com/Saketh-Gurram/VS_code_note_taker/issues"
  },
  "engines": { "vscode": "^1.100.0" },
  "extensionKind": ["ui"],
  "categories": ["Other", "Notebooks"],
  "keywords": ["notes", "pixel-art", "notepad", "todo", "ai"],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pixel-notes-container",
          "title": "PixelNotes",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "pixel-notes-container": [
        {
          "type": "webview",
          "id": "pixelNotes.mainView",
          "name": "PixelNotes",
          "retainContextWhenHidden": false
        }
      ]
    },
    "commands": [
      {
        "command": "pixelNotes.newNote",
        "title": "PixelNotes: New Note",
        "icon": "$(add)"
      },
      {
        "command": "pixelNotes.pickCodeRef",
        "title": "PixelNotes: Add Code Reference to Note"
      },
      {
        "command": "pixelNotes.sendToAI",
        "title": "PixelNotes: Send Active Note to AI"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pixelNotes.pickCodeRef",
          "group": "pixelNotes@1",
          "when": "editorFocus"
        }
      ],
      "view/title": [
        {
          "command": "pixelNotes.newNote",
          "when": "view == pixelNotes.mainView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build:ext": "node esbuild.mjs",
    "build:webview": "cd webview-ui && npm run build",
    "build": "npm run build:webview && npm run build:ext",
    "watch:ext": "node esbuild.mjs --watch",
    "watch:webview": "cd webview-ui && npm run dev",
    "watch": "concurrently \"npm run watch:ext\" \"npm run watch:webview\"",
    "package": "npm run build && npx vsce package",
    "publish": "npm run build && npx vsce publish",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
